{
  "name": "pi-tiers",
  "version": "0.1.11",
  "description": "Work tiers for Pi: each tier is a virtual model that commits a session to one model from an ordered chain (resilient tiers keep failover), and tier/auto picks the tier with a classifier.",
  "keywords": ["pi-package", "pi-extension", "router", "virtual-model", "fallback"],
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/1yian/pi-tiers.git" },
  "pi": { "extensions": ["./src/index.ts"] },
  "files": ["src", "examples", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "e2e": "node test/e2e/run.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
